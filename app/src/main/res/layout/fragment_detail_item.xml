<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.clinics.DetailItemFragment">
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_div"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="40dp"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/item_img"
            android:layout_width="135dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_background"
            android:src="@drawable/image_preview"
            android:contentDescription="@string/item_image"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:elevation="4dp"
            android:padding="6dp"
            />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/item_img"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_bold"
            android:textSize="22sp"
            android:textColor="@color/font_grey"
            android:text="@string/lorem_ipsum"/>
        <TextView
            android:id="@+id/sub_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toEndOf="@id/item_img"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/lorem_ipsum"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginStart="10dp"
            android:textSize="20sp"
            android:textColor="@color/pink"
            />
        <androidx.cardview.widget.CardView
            android:id="@+id/horizontal_line"
            android:layout_width="0dp"
            android:layout_height="2dp"
            app:layout_constraintTop_toBottomOf="@id/sub_title"
            app:layout_constraintStart_toEndOf="@id/item_img"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            app:cardCornerRadius="4dp"
            android:backgroundTint="@color/black"
            android:alpha="0.2"
            />
        <TextView
            android:id="@+id/category_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/horizontal_line"
            app:layout_constraintStart_toEndOf="@id/item_img"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_bold"
            android:textSize="12sp"
            android:text="@string/kategori"
            android:textColor="@color/font_grey"
            />
        <TextView
            android:id="@+id/category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/category_title"
            app:layout_constraintStart_toEndOf="@id/item_img"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_regular"
            android:textSize="12sp"
            android:text="@string/kategori"
            android:textColor="@color/font_grey"
            />
        <TextView
            android:id="@+id/category_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/category"
            app:layout_constraintStart_toEndOf="@id/item_img"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_bold"
            android:textSize="12sp"
            android:text="@string/kategori"
            android:textColor="@color/font_grey"
            />
        <TextView
            android:id="@+id/category_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/category_title_2"
            app:layout_constraintStart_toEndOf="@id/item_img"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/poppins_regular"
            android:textSize="12sp"
            android:text="@string/kategori"
            android:textColor="@color/font_grey"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/description_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/main_div"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/deskripsi"
        android:layout_marginHorizontal="40dp"
        android:fontFamily="@font/poppins_bold"
        android:textSize="20sp"
        android:textColor="@color/font_grey"
        />
    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description_title"
        android:text="@string/lorem_ipsum_paragraph"
        android:layout_marginHorizontal="40dp"
        android:justificationMode="inter_word"
        android:fontFamily="@font/poppins_regular"
        android:textSize="12sp"
        android:textColor="@color/font_grey"
        />

    <TextView
        android:id="@+id/sub_description_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/description"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/deskripsi"
        android:layout_marginHorizontal="40dp"
        android:fontFamily="@font/poppins_bold"
        android:textSize="20sp"
        android:textColor="@color/font_grey"
        />
    <TextView
        android:id="@+id/sub_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sub_description_title"
        android:text="@string/lorem_ipsum_paragraph"
        android:layout_marginHorizontal="40dp"
        android:justificationMode="inter_word"
        android:fontFamily="@font/poppins_regular"
        android:textSize="12sp"
        android:textColor="@color/font_grey"
        />

    <TextView
        android:id="@+id/sub_description_title_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/sub_description"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/deskripsi"
        android:layout_marginHorizontal="40dp"
        android:fontFamily="@font/poppins_bold"
        android:textSize="20sp"
        android:textColor="@color/font_grey"
        />
    <LinearLayout
        android:id="@+id/sub_description_2_div"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sub_description_title_2"
        android:layout_marginHorizontal="40dp"
        >
        <!-- dynamic description item -->
    </LinearLayout>
    <Button
        android:id="@+id/redirect_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/sub_description_2_div"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="@string/click_here"
        />

</androidx.constraintlayout.widget.ConstraintLayout>