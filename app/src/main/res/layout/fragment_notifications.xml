<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="?attr/backgroundColor"
    android:layout_height="match_parent"
    tools:context=".ui.notifications.NotificationsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_div"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp"
        android:layout_marginTop="24dp"
        >
        <TextView
            android:id="@+id/btn_scan_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="@string/scan"
            android:background="@drawable/rounded_background"
            android:backgroundTint="@color/secondary_pink"
            android:fontFamily="@font/poppins_semi_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="2dp"
            android:textColor="@color/font_brown"
            android:gravity="center"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/btn_obat_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_scan_tab"
            android:text="@string/obat"
            android:background="@drawable/rounded_background"
            android:backgroundTint="@color/grey"
            android:fontFamily="@font/poppins_semi_bold"
            android:paddingHorizontal="16sp"
            android:paddingVertical="2sp"
            android:layout_marginStart="12sp"
            android:textColor="@color/font_grey"
            android:gravity="center"
            android:textSize="14sp" />
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/search_input"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/rounded_background_stroke"
            android:paddingVertical="2sp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/font_grey"
            android:fontFamily="@font/poppins_regular"
            android:textSize="16sp"
            android:drawableStart="@drawable/baseline_search_24"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btn_div"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="26dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>